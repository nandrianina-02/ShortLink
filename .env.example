MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/shortlink
BASE_URL=http://localhost:3000
PORT=3000

# Obligatoires : longues chaînes aléatoires (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=change-moi
HASH_SALT=change-moi

# Fuseau horaire des stats par jour
TZ_STATS=Indian/Antananarivo

# true = il faut un compte pour créer un lien (recommandé en production)
REQUIRE_LOGIN=false

# Facultatif : clé Google Safe Browsing (https://developers.google.com/safe-browsing)
SAFE_BROWSING_KEY=

# Facultatif : domaines interdits en plus de la liste intégrée, séparés par des virgules
BLOCKED_DOMAINS=

# Emails des administrateurs (page /admin), séparés par des virgules. Le compte doit exister.
ADMIN_EMAILS=
